{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZWriter",
  "version": "0.2.0",
  "identifier": "com.alinawaz.zwriter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZWriter",
        "width": 780,
        "height": 600,
        "minWidth": 540,
        "minHeight": 420,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "ZWriter Settings",
        "url": "index.html#/settings",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 420,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
